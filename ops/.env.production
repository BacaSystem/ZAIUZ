# Production Environment Configuration
# Override these values for cloud deployment

# POSTGRES 
POSTGRES_DB=measurements_db
POSTGRES_USER=user
POSTGRES_PASSWORD=your_secure_password_here

# Use cloud database port (usually 5432)
PG_PORT=5432

# Backend configuration
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_EXPIRATION_TIME=3600000

# Cloud-specific origins (update with your domain)
FRONTEND_ORIGIN=https://your-domain.com

# Cloud ports
BACKEND_PORT=8080
FRONTEND_PORT=80

# Database configuration for cloud
DATABASE_HOST=your-cloud-db-host
DATABASE_PORT=5432

# Optional: Cloud-specific settings
# ENVIRONMENT=production
# LOG_LEVEL=INFO