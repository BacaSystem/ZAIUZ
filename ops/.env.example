# Production Environment Configuration Template
# Copy this file to .env.production and customize for your deployment

# POSTGRES 
POSTGRES_DB=measurements_db
POSTGRES_USER=zaiuz_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD  # IMPORTANT: Use a strong password!

# Use standard PostgreSQL port
PG_PORT=5432

# Backend configuration
JWT_SECRET_KEY=GENERATE_A_SECURE_64_CHAR_KEY_HERE  # Use: openssl rand -hex 32
JWT_EXPIRATION_TIME=3600000

# Frontend origin (your VM IP or domain)
FRONTEND_ORIGIN=http://YOUR_VM_IP_OR_DOMAIN  # Example: http://51.103.208.127 or http://your-domain.com

# Cloud ports
BACKEND_PORT=8080
FRONTEND_PORT=80

# Database configuration - using containerized DB
DATABASE_HOST=db
DATABASE_PORT=5432

# Production settings
ENVIRONMENT=production
LOG_LEVEL=INFO
